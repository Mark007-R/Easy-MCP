# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env — it is gitignored on purpose.
# Used by examples/aws_server.py  (pip install python-dotenv boto3)

# --- AWS credentials for the boto3-backed tools ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# --- Optional: gate the AWS tools behind an "aws" scope ---
# Any long random string. Clients must send: Authorization: Bearer <this>
EASY_MCP_AWS_KEY=change-me-to-a-long-random-string
